        .explore {
            max-width: 1100px;
            margin: 0 auto 4rem auto;
            padding: 0 2rem;
        }

        .explore-title {
            font-family: 'Cinzel', serif;
            font-size: 1.6rem;
            margin-bottom: 1.5rem;
        }

        .card-row {
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: 260px;
            gap: 2rem;
            overflow-x: auto;
            padding-bottom: 1rem;
            scroll-snap-type: x mandatory;
        }
        .mini-card {
            scroll-snap-align: start;
        }

        .mini-card {
            padding: 1.25rem;
        }

        .mini-thumb {
            display: block;
            width: 100%;
            aspect-ratio: 4 / 3;
            object-fit: cover;
            border-radius: 4px;
            margin-bottom: 1rem;
            background: var(--border-subtle);
        }

        .mini-title {
            font-family: 'Cinzel', serif;
            font-size: 1.05rem;
            line-height: 1.3;
            margin-bottom: 0.75rem;
        }

        .mini-title a {
            text-decoration: none;
            color: var(--text-sepia);
        }

        .mini-title a:hover {
            color: var(--accent-blue);
        }

        .mini-card .post-source {
            margin-bottom: 0;
        }

